<view class="page"><view wx:if="{{loading}}" class="empty">订单加载中…</view><view wx:elif="{{error}}" class="error">{{error}}</view><block wx:elif="{{order}}"><view class="status-card"><text class="cup">☕</text><text class="status">{{order.statusText}}</text><text class="muted">订单号 {{order.orderNo}}</text></view><view class="card"><view class="line" wx:for="{{order.items}}" wx:key="id"><view class="grow"><text class="name">{{item.productName}} × {{item.quantity}}</text><text class="muted specs">{{item.optionText}}</text></view><text>¥{{item.amountText}}</text></view><view class="row between total"><text>合计</text><text class="price">¥{{order.amountText}}</text></view></view><view class="card"><text class="name">状态记录</text><view class="log" wx:for="{{order.statusLogs}}" wx:key="createdAt"><text>{{item.toStatus}}</text><text class="muted">{{item.createdAt}}</text></view></view><button wx:if="{{order.status==='PENDING_ACCEPTANCE'}}" class="ghost" bindtap="cancel">取消订单</button><button class="primary" bindtap="menu">再来一单</button></block></view>
