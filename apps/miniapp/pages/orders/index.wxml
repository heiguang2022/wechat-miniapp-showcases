<view class="page"><view class="row between"><text class="title">我的订单</text><text class="muted" bindtap="load">刷新</text></view><view wx:if="{{loading}}" class="empty">订单加载中…</view><view wx:elif="{{error}}" class="error">{{error}}</view><view wx:elif="{{!orders.length}}" class="empty"><text class="empty-icon">🧾</text><text>暂无订单</text><button class="primary" bindtap="menu">去点一杯</button></view><view class="card order" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="row between"><text class="tag">{{item.statusText}}</text><text class="muted">{{item.itemCount}} 件</text></view><text class="no">{{item.orderNo}}</text><view class="row between"><text class="muted">{{item.createdAt}}</text><text class="price">¥{{item.amountText}} 〉</text></view></view></view>
