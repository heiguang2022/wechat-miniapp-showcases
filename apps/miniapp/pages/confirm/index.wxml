<view class="page"><text class="title">确认订单</text><view class="card"><text class="muted">到店自取</text><text class="store">{{cart.storeName}}</text></view><view class="card"><view class="line" wx:for="{{cart.items}}" wx:key="key"><view><text>{{item.name}} × {{item.quantity}}</text><text class="muted specs">{{item.optionText}}</text></view><text>¥{{item.lineText}}</text></view></view><view class="card"><view class="row between"><text>支付方式</text><text>到店支付（演示）</text></view><view class="row between total"><text>应付合计</text><text class="price">¥{{amountText}}</text></view></view><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交订单 · ¥{{amountText}}</button></view>
