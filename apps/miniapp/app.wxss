page{background:#f6f2eb;color:#28251f;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:28rpx 28rpx 60rpx}.brand{font-family:Georgia,serif;font-size:48rpx;font-weight:700}.muted{color:#8a8277}.card{background:#fffaf4;border-radius:24rpx;padding:26rpx;margin-bottom:22rpx;box-shadow:0 8rpx 30rpx rgba(63,47,31,.06)}.primary{background:#285b49!important;color:#fff!important;border-radius:999rpx!important}.ghost{background:#eee7dc!important;color:#39332b!important;border-radius:999rpx!important}.row{display:flex;align-items:center}.between{justify-content:space-between}.grow{flex:1}.title{font-size:38rpx;font-weight:700;margin-bottom:24rpx}.price{font-family:Georgia,serif;font-weight:700}.empty{text-align:center;padding:120rpx 20rpx}.empty-icon{font-size:90rpx;display:block;margin-bottom:18rpx}.tag{display:inline-block;background:#e7efe9;color:#285b49;padding:6rpx 14rpx;border-radius:999rpx;font-size:22rpx}.error{padding:20rpx;background:#fff0ed;color:#a53c2f;border-radius:16rpx;margin:20rpx 0}
